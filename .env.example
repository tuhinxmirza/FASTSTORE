# ---- Browser-safe (VITE_ prefix is exposed to the client) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Server-only: set as Supabase Edge Function secrets, NEVER in the frontend ----
# supabase secrets set FAST_STORE_ADMIN_EMAILS="you@gmail.com,second@gmail.com"
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are injected automatically into Edge Functions)
FAST_STORE_ADMIN_EMAILS=your-admin@gmail.com
